# ---- Percepción (RA2-01) ----
# Reportes que escribe el flujo n8n. Se montan en SOLO LECTURA.
CENTINELA_REPORTES_DIR=/centinela/reports
# Único directorio donde escribe este agente: veredictos.jsonl, meta_alertas.jsonl, trazas/.
# El Agente 1 lee veredictos.jsonl (AGENTE2_VEREDICTOS_PATH) para su modelo de relaciones.
AGENTE2_DATA_DIR=/data/agente2
# Trazas del Agente 1 (opcional): el detalle de un reporte muestra su razonamiento.
AGENTE1_TRAZAS_DIR=/agente1/trazas

# ---- API (RA2-08) ----
# Token Bearer para registrar veredictos. Vacío = escritura deshabilitada. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTE2_TOKEN=
CORS_ORIGENES=http://localhost:5173

# ---- Estándar de desempeño del crítico (RA2-03) ----
# Costo relativo de cada error: entregar un malicioso vs demorar un legítimo vs tiempo de analista.
COSTO_FALSO_NEGATIVO=20
COSTO_FALSO_POSITIVO=1
COSTO_ESCALAR=0.2

# ---- Umbrales vigentes en el flujo (deben coincidir con "Consolidar evidencia y puntuar") ----
UMBRAL_ESCALAR=30
UMBRAL_BLOQUEAR=65
# Veredictos humanos mínimos (con ambas clases) antes de proponer umbrales (RA2-04). 40 sale del
# experimento experimentos/curva_aprendizaje.py: con 10-20 los umbrales aprendidos son PEORES que los
# vigentes en casos reservados; desde 40 son mejores en la mayoría de las particiones.
MUESTRA_MINIMA=40
# Proporción de degradaciones de la IA que resultan maliciosas a partir de la cual se considera riesgosa (RA2-11).
TOLERANCIA_DEGRADACION_IA=0.10
# Dominios propios: no unen actores distintos en la correlación de campañas (RA2-10).
DOMINIOS_PROPIOS=ejercito.mil.ar,argentina.gob.ar,mil.ar

# ---- Supervisión del decisor IA (RA2-05) ----
SUPERVISION_VENTANA=20
SUPERVISION_MINIMO=5
AGENTE2_INTERVALO_S=10

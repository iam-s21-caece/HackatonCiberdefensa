# ---- Modelo de la organización (RA1-02) ----
# Dominios propios. Se suman a los que ya trae la configuración del flujo (DOMINIOS_PROPIOS de n8n).
DOMINIOS_PROPIOS=ejercito.mil.ar
# MX de confianza adicionales. Los MX públicos de los dominios propios se aprenden solos por DNS.
MX_CONFIABLES=
# authserv-id aceptados en Authentication-Results. Vacío = los MX de confianza.
AUTHSERV_CONFIABLES=

# ---- Vías de entrada confiables (RA1-03) ----
# Indica en qué vías las cabeceras Received las escribió nuestra infraestructura:
#   imap       -> leído del buzón: confiable.
#   eml_crudo  -> .eml subido al webhook: habilitar SOLO si quien lo sube es un componente propio
#                 (p. ej. la demo con las muestras). Si cualquiera puede subirlo, puede forjar el Received.
# Aunque una vía no esté habilitada, DKIM se sigue verificando: no depende de la ruta.
ORIGENES_CONFIABLES=imap

# ---- DNS y tiempos (RA1-12) ----
DNS_TIMEOUT_S=2
# Servidores DNS separados por coma. Vacío = los del sistema.
DNS_SERVIDORES=
# Tiempo máximo por análisis. El nodo de n8n espera 8 s.
AGENTE1_PRESUPUESTO_S=5
AGENTE1_MAX_EML_BYTES=10485760

# ---- Persistencia y aprendizaje del modelo de relaciones (RG-03, RA1-08) ----
AGENTE1_DATA_DIR=/data/agente1
# Opcionales: sin ellos el modelo de relaciones no aprende (el agente funciona igual).
CENTINELA_REPORTES_DIR=/centinela/reports
AGENTE2_VEREDICTOS_PATH=/agente2/veredictos.jsonl
AGENTE1_INTERVALO_APRENDIZAJE_S=15

# =====================================================================================================
#  CENTINELA · configuración del ecosistema — RNF-03
#  `scripts/levantar.sh` copia este archivo a .env la primera vez y completa los secretos vacíos
#  (AGENTE2_TOKEN, hash del administrador de n8n). .env NO se versiona.
#  TODO lo demás es opcional: sin API keys, CENTINELA funciona con heurísticas + DNS + crt.sh + RDAP + IA local.
# =====================================================================================================

# ----------------------------------------------------------------------------- versiones (RNF-04)
# Fijas a propósito: son variables controladas del experimento. Cambiarlas invalida la comparación
# con evidencias anteriores (verificar_e2e.sh las registra en cada corrida).
N8N_VERSION=2.39.7
OLLAMA_VERSION=0.34.1

# ----------------------------------------------------------------------------- red
# 127.0.0.1 = sólo esta máquina. Los webhooks no tienen autenticación: no publicar en 0.0.0.0 sin
# un proxy con autenticación delante (levantar.sh se niega si además se confía en eml_crudo/json_estructurado).
CENTINELA_BIND=127.0.0.1
N8N_PUERTO=5678
OLLAMA_PUERTO=11434
AGENTE1_PUERTO=8101
AGENTE2_PUERTO=8102
INTERFAZ_PUERTO=8088

# ----------------------------------------------------------------------------- flujo n8n
# VirusTotal (gratis, 4 req/min): https://www.virustotal.com/gui/my-apikey
VT_API_KEY=
# AbuseIPDB (gratis, 1000 checks/día): https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
# abuse.ch (URLhaus + MalwareBazaar + ThreatFox, una sola key gratis): https://auth.abuse.ch/
ABUSECH_API_KEY=

# IA que decide: ollama (local) | deepseek (API externa) | auto (deepseek si DEEPSEEK_API_KEY tiene valor; si no, ollama)
# ATENCIÓN: con DeepSeek la evidencia de cada mensaje (remitente, asunto, cuerpo, URLs) sale de la máquina hacia
# api.deepseek.com. Con Ollama no sale nada. La key nunca se escribe en los reportes.
IA_PROVEEDOR=auto
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Modelo de Ollama (lo descarga el servicio ollama-modelo la primera vez)
# Livianos: llama3.2:3b (2 GB) | qwen2.5:3b | Mejores: qwen2.5:7b | llama3.1:8b (5 GB, ideal con GPU)
OLLAMA_MODEL=llama3.2:3b

# Dominios de la organización (para detectar suplantación / lookalikes), separados por coma
DOMINIOS_PROPIOS=ejercito.mil.ar,argentina.gob.ar,mil.ar
# Números o IDs institucionales de WhatsApp/SMS (E.164 sin espacios, o ID alfanumérico), separados por coma.
NUMEROS_PROPIOS=
# Código de país E.164 de la organización (54 = Argentina): números de otro país se marcan como señal
PAIS_PROPIO=54
# Webhook del SOC para alertas (Slack / Discord / TheHive / Mattermost). Vacío = sólo bitácora local
SOC_WEBHOOK_URL=

# Administrador de n8n creado desde el entorno. Con N8N_OWNER_EMAIL completo y el hash vacío,
# levantar.sh genera una contraseña, guarda sólo su hash bcrypt acá, pone DESDE_ENTORNO=true y la
# muestra UNA vez. Con false (p. ej. `docker compose up` sin el script) se crea a mano en http://localhost:5678.
N8N_OWNER_DESDE_ENTORNO=false
N8N_OWNER_EMAIL=admin@centinela.local
N8N_OWNER_PASSWORD_HASH=

# ----------------------------------------------------------------------------- Agente 1 (identidad)
# Dominios cuya identidad verifica (aprende sus MX por DNS). Se suman a los del flujo que llegan en cada reporte.
AGENTE1_DOMINIOS_PROPIOS=ejercito.mil.ar
# MX de confianza adicionales y authserv-id aceptados en Authentication-Results (vacío = los MX aprendidos)
MX_CONFIABLES=
AUTHSERV_CONFIABLES=
# Vías de entrada cuyas cabeceras Received escribió nuestra infraestructura (RA1-03):
#   imap               -> leído del buzón: confiable. ÚNICO valor para producción.
#   eml_crudo          -> .eml subido al webhook
#   json_estructurado  -> JSON subido al webhook
# PERFIL DEMO: las muestras las sube scripts/analizar.sh desde esta máquina (puertos en 127.0.0.1),
# por eso se confía en las tres. Con el webhook expuesto, cualquiera podría forjar un Received.
ORIGENES_CONFIABLES=imap,eml_crudo,json_estructurado
# Agente 1 fuera de este compose (raro). Vacío = http://agente-identidad:8101 por la red del proyecto
AGENTE1_URL=

# ----------------------------------------------------------------------------- Agente 2 (aprendizaje)
# Token Bearer para registrar veredictos humanos. Vacío -> levantar.sh genera uno.
AGENTE2_TOKEN=
# Umbrales vigentes en el flujo (deben coincidir con "Consolidar evidencia y puntuar")
UMBRAL_ESCALAR=30
UMBRAL_BLOQUEAR=65
# Veredictos humanos mínimos antes de proponer umbrales (sale de experimentos/curva_aprendizaje.py)
MUESTRA_MINIMA=40
# Reportes que leen los agentes. Vacío = ./data/reports (los que escribe n8n)
CENTINELA_REPORTES_DIR=

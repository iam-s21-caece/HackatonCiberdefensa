# nginx de la interfaz de CENTINELA — RI-08, RNF-02.
#
# Hace en el contenedor lo mismo que el proxy de Vite en desarrollo, con las MISMAS rutas:
#   /api/*          -> Agente 2 (la API de la interfaz)
#   /agente1/salud  -> Agente 1, sólo su estado (su /analizar es para n8n, no para el navegador)
# Las ${VARIABLES} las reemplaza envsubst al arrancar (entrypoint de la imagen oficial).

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # ---------------------------------------------------------------- Agente 2
    location /api/ {
        limit_except GET POST { deny all; }
        proxy_pass http://${AGENTE2_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cache off;
        add_header Cache-Control "no-store" always;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        client_max_body_size 64k;
    }

    # ---------------------------------------------------------------- Agente 1 (sólo estado)
    location = /agente1/salud {
        limit_except GET { deny all; }
        proxy_pass http://${AGENTE1_UPSTREAM}/salud;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_cache off;
        add_header Cache-Control "no-store" always;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }

    # ---------------------------------------------------------------- estáticos
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }
    location = /index.html {
        add_header Cache-Control "no-store" always;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Sonda del healthcheck: responde si la interfaz se sirve, no si los agentes contestan (eso lo
    # muestra el panel; no es motivo para reiniciar el contenedor).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}

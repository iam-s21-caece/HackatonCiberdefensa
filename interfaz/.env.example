# Configuración de la interfaz. Copiar a `.env.local` y editar. TODAS son opcionales.

# ----- Desarrollo (`npm run dev`) ----------------------------------------------------------
# A dónde apunta el proxy de Vite. El navegador siempre pide /api y /agente1/salud al propio
# servidor de desarrollo; estas son las URLs reales detrás.
VITE_AGENTE2_TARGET=http://localhost:8102
VITE_AGENTE1_TARGET=http://localhost:8101

# ----- Build estático sin reverse proxy (poco común) ---------------------------------------
# Vacías = rutas relativas, que es lo correcto detrás de nginx (Dockerfile de esta carpeta).
# VITE_API_BASE=http://<host>:8102
# VITE_AGENTE1_BASE=http://<host>:8101

# ----- Refresco -----------------------------------------------------------------------------
VITE_REFRESH_MS=10000

# ----- Contenedor (docker-compose.yml de la raíz) --------------------------------------------
# No son variables de Vite: las resuelve nginx al arrancar, la imagen no se reconstruye.
# AGENTE2_UPSTREAM=agente-aprendizaje:8102
# AGENTE1_UPSTREAM=agente-identidad:8101
